    {
      "name": "deletebeer",
      "description": "Deletes a logged beer by id.",
      "request_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "getbeer",
      "description": "Gets one logged beer by id.",
      "request_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "listbeers",
      "description": "Lists logged beers, newest first, with optional search text, verdict, venue type, and place filters.",
      "request_schema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "maxLength": 120
          },
          "verdict": {
            "type": "string",
            "enum": [
              "love",
              "like",
              "ok",
              "dislike"
            ]
          },
          "venueType": {
            "type": "string",
            "enum": [
              "brewery",
              "restaurant",
              "bar",
              "home",
              "friend",
              "store",
              "festival",
              "other"
            ]
          },
          "placeKey": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    {
      "name": "lookupbeer",
      "description": "Looks up a beer by name on the web and returns its component breakdown (brewery, style, ABV, IBU, hops, malts, flavor notes, bitterness/sweetness/body scores) with source links.",
      "request_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "searchplaces",
      "description": "Searches for real venues (brewery, restaurant, bar, shop) by name, biased to the user's home area unless a city is given, and returns candidate places with full address and coordinates for the user to confirm.",
      "request_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "city": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "gethome",
      "description": "Returns the home dashboard: totals, recent beers, top loved flavor, and whether the taste questions are answered.",
      "request_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getinsights",
      "description": "Computes the taste-connection engine output: flavor, hop, malt, and style affinities plus bitterness/sweetness/body patterns by verdict, and the saved narrative summary.",
      "request_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "generatetastesummary",
      "description": "Uses the logged beers and taste answers to write a short taste-profile summary and concrete flavor connections, saved to the profile.",
      "request_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "generatesuggestions",
      "description": "Generates fresh For You beer suggestions: real beers matched to the user's taste profile, each with a reason tied to their logged likes and dislikes.",
      "request_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getsuggestions",
      "description": "Returns the saved For You beer suggestions and when they were generated.",
      "request_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getplaces",
      "description": "Aggregates all venues from logged beers: places visited with visit counts, beer counts, average rating, and venue-type totals.",
      "request_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "gettastequestions",
      "description": "Returns the taste-profile questions with the user's saved answers.",
      "request_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "getquestionoftheday",
      "description": "Returns the next unanswered taste question (rotating by day), or null when all are answered.",
      "request_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "savetasteanswer",
      "description": "Saves (or clears, with an empty answer) one taste-profile question answer.",
      "request_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "answer": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "key",
          "answer"
        ]
      }
    }
  ]
}