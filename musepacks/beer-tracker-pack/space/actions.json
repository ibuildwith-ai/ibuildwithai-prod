{
  "actions": [
    {
      "name": "createbeer",
      "description": "Logs a beer the user drank, with its breakdown, verdict, and where they tried it.",
      "request_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "brewery": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          },
          "style": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "abv": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 70
              },
              {
                "type": "null"
              }
            ]
          },
          "ibu": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "hops": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "maxItems": 20,
            "default": []
          },
          "malts": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "maxItems": 20,
            "default": []
          },
          "yeast": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "flavorNotes": {
            "type": "array",
            "maxItems": 14,
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "note": {
                  "type": "string"
                },
                "intensity": {
                  "type": "number"
                }
              },
              "required": [
                "note",
                "intensity"
              ]
            }
          },
          "likedNotes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "maxItems": 14,
            "default": []
          },
          "dislikedNotes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "maxItems": 14,
            "default": []
          },
          "bitterness": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "sweetness": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "bodyScore": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "carbonation": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "love",
              "like",
              "ok",
              "dislike"
            ]
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "wouldDrinkAgain": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "serving": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "triedDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lookupStatus": {
            "type": "string",
            "enum": [
              "found",
              "manual"
            ],
            "default": "manual"
          },
          "sources": {
            "type": "array",
            "maxItems": 8,
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ]
            }
          },
          "venueType": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "brewery",
                  "restaurant",
                  "bar",
                  "home",
                  "friend",
                  "store",
                  "festival",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "venueName": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "venueAddress": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "venueCity": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "venueLat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "venueLng": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "placeId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "venueManual": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "name",
          "verdict",
          "triedDate"
        ]
      }
    },
